# Environment
TEST_ENV=local

# Admin URLs
BASE_URL=http://localhost:4000
LOCAL_BASE_URL=http://localhost:4000
STAGING_BASE_URL=https://admin-staging.xlm.com
PROD_BASE_URL=https://admin.xlm.com

# API URLs
API_URL=http://localhost:4000/api
STAGING_API_URL=https://api-staging.xlm.com
PROD_API_URL=https://api.xlm.com

# Admin Test User - Local
ADMIN_TEST_EMAIL=admin@xlm.com
ADMIN_TEST_PASSWORD=AdminPass123!

# Admin Test User - Staging
STAGING_ADMIN_EMAIL=staging-admin@xlm.com
STAGING_ADMIN_PASSWORD=StagingAdminPass123!

# Admin Test User - Production (Read-only)
PROD_ADMIN_EMAIL=prod-admin@xlm.com
PROD_ADMIN_PASSWORD=ProdAdminPass123!

# Timeouts
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Feature Flags
ENABLE_SCREENSHOTS=true
ENABLE_VIDEOS=false
ENABLE_TRACE=false