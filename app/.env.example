# Environment
TEST_ENV=local

# App URLs
BASE_URL=http://localhost:3000
LOCAL_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://app-staging.xlm.com
PROD_BASE_URL=https://app.xlm.com

# API URLs
API_URL=http://localhost:3000/api
STAGING_API_URL=https://api-staging.xlm.com
PROD_API_URL=https://api.xlm.com

# Test User - Local
TEST_USER_EMAIL=test@xlm.com
TEST_USER_PASSWORD=TestPass123!

# Test User - Staging
STAGING_TEST_USER_EMAIL=staging-test@xlm.com
STAGING_TEST_USER_PASSWORD=StagingPass123!

# Test User - Production (Read-only)
PROD_TEST_USER_EMAIL=prod-test@xlm.com
PROD_TEST_USER_PASSWORD=ProdPass123!

# Timeouts
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Feature Flags
ENABLE_SCREENSHOTS=true
ENABLE_VIDEOS=false
ENABLE_TRACE=false