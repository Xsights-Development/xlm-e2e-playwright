{
  "testCases": [
    {
      "section": "Authentication",
      "testId": "TC-APP-001",
      "testSuite": "Login with valid credentials",
      "description": "Verify user can login with valid email and password",
      "page": "LoginPage",
      "testData": {
        "email": "test@xlm.com",
        "password": "TestPass123!"
      },
      "preconditions": [
        "User is not logged in",
        "User has valid account",
        "Browser is opened"
      ],
      "scenarios": [
        "Navigate to login page",
        "Enter valid email address",
        "Enter valid password",
        "Click on Login button"
      ],
      "expectedResults": [
        "User is redirected to dashboard page",
        "Welcome message is displayed",
        "User menu shows user name"
      ]
    },
    {
      "section": "Authentication",
      "testId": "TC-APP-002",
      "testSuite": "Login with invalid credentials",
      "description": "Verify error message when login with wrong credentials",
      "page": "LoginPage",
      "testData": {
        "email": "invalid@xlm.com",
        "password": "WrongPass123"
      },
      "preconditions": [
        "User is on login page"
      ],
      "scenarios": [
        "Enter invalid email",
        "Enter invalid password",
        "Click Login button"
      ],
      "expectedResults": [
        "Error message 'Invalid credentials' is displayed",
        "User remains on login page",
        "Input fields are not cleared"
      ]
    }
  ]
}