# ========================================
# Target (dev | staging)
# ========================================
# URLs, API hosts, locale branch, tenant, farm, location, and timezone
# are fixed per target in configs/targets.json.
# This is the only switch. Do not set APP_URL / API_BASE_URL / CUBE_API_URL / ADMIN_URL
# or APP_TENANT_IDENTIFIER / APP_FARM_IDENTIFIER / APP_LOCATION_* / APP_API_FARM_IDENTIFIER / APP_TIMEZONE.
E2E_TARGET=dev

# ========================================
# App - Credentials (REQUIRED)
# ========================================
APP_USER=your-email
APP_PASS=your-password

# ========================================
# Admin API — @business QC gate (credentials only; host comes from the target)
# ========================================
ADMIN_USER=your-admin-username
ADMIN_PASS=your-admin-password

# ========================================
# Integrations (OPTIONAL — CI only)
# ========================================
# GitHub secret SLACK_WEBHOOK_URL = Incoming Webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Toggle result notification (workflow input xlm_slack_notify / script env):
# XLM_SLACK_NOTIFY=on   # default — post summary when webhook is set
# XLM_SLACK_NOTIFY=off  # skip Notify Slack step / script

# ========================================
# Dashboard locales (REQUIRED for local i18n)
# ========================================
# PAT with Contents: Read on Xsights-Development/xlm-dashboard.
# Local i18n sparse-checks out src/locales/lang into .cache/xlm-dashboard.
# Missing token fails the i18n suite beforeAll, before TC01. It is not a separate test.
# CI uses the workflow checkout (this secret is optional there; github.token is the fallback).
DASHBOARD_CHECKOUT_TOKEN=
# Locale branch is chosen by E2E_TARGET (dev → revised-ui-version, staging → staging).
