# ========================================
# App - Credentials (REQUIRED)
# ========================================
APP_URL=your-app-url
APP_USER=your-email
APP_PASS=your-password
# Tenant/farm selection uses identifier (fallback: APP_TENANT/APP_FARM if identifier not set)
APP_TENANT_IDENTIFIER=your-tenant-identifier
APP_FARM_IDENTIFIER=your-farm-identifier
# Legacy / display (optional): APP_TENANT=your-tenant-name  APP_FARM=your-farm-name

# ========================================
# App - Test Location (REQUIRED)
# CI/CD will use these values to auto-generate test data
# ========================================
APP_LOCATION_TYPE=your-location-type
APP_LOCATION_IDENTIFIER=your-location-identifier

# ========================================
# Admin API - Credentials (for data validation via Admin API)
# Compare webapp data with Admin API; fixture adminApi in fixtures/auth.fixture.ts or admin-api.fixture.ts
# ADMIN_URL = base only, no trailing slash (e.g. https://api.staging.xiot.com.au)
# ========================================
ADMIN_URL=your-admin-api-url
ADMIN_USER=your-admin-username
ADMIN_PASS=your-admin-password

# ========================================
# Integrations (OPTIONAL)
# ========================================
SLACK_WEBHOOK_URL=your-slack-webhook-url
CUBE_API_URL=your-cube-api-url
CUBE_API_TOKEN=your-cube-api-token
