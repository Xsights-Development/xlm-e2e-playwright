{
  "name": "xlm-e2e-playwright",
  "version": "1.0.0",
  "description": "E2E automated tests for XLM App using Playwright",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --grep @ui",
    "test:data": "playwright test --grep @data",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report tests/reports/playwright/html",
    "test:tc": "playwright test -g",
    "test:tc:headed": "playwright test --headed -g",
    "test:tc:debug": "playwright test --debug -g ",
    "test:mixed": "playwright test tests/specs/room-dashboard/tag-deployed-mixed.spec.js",
    "test:mixed:headed": "playwright test tests/specs/room-dashboard/tag-deployed-mixed.spec.js --headed",
    "clean": "rm -rf tests/reports",
    "install:browsers": "npx playwright install"
  },
  "keywords": [
    "xlm",
    "e2e",
    "playwright",
    "testing",
    "automation"
  ],
  "author": "XLM Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^17.2.3"
  }
}
