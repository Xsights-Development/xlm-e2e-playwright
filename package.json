{
    "name": "xlm-e2e-playwright",
    "version": "1.0.0",
    "description": "E2E automated tests for XLM App using Playwright",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:report": "playwright show-report reports/html",
        "browsers": "playwright install chromium",
        "codegen": "playwright codegen",
        "probe": "tsx scripts/probe.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@types/node": "^25.0.10",
        "dotenv": "^17.2.3",
        "tsx": "^4.19.2",
        "typescript": "^5.9.3"
    }
}
