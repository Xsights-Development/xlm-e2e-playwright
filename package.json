{
  "name": "xlm-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "E2E automated tests for XLM Application using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --grep @ui",
    "test:data": "playwright test --grep @data",
    "test:006": "playwright test -g \"TC-TAGS-006\"",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:playwright-ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:auth": "playwright test tests/specs/auth",
    "test:dashboard": "playwright test tests/specs/dashboard",
    "test:dashboard:ui": "playwright test tests/specs/dashboard/ui",
    "test:dashboard:data": "playwright test tests/specs/dashboard/data",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "clean": "rm -rf playwright-report test-results allure-results allure-report tests/reports",
    "install:browsers": "npx playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "allure-playwright": "^3.4.2",
    "dotenv": "^17.2.3"
  },
  "keywords": [
    "xlm",
    "e2e",
    "playwright",
    "testing",
    "automation"
  ],
  "author": "XLM Team",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@cubejs-client/core": "^1.5.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45"
  }
}
