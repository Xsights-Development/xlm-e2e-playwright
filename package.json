{
  "name": "xlm-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "E2E automated tests for XLM projects (App & Admin) using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",

    "test:app": "playwright test --project=app",
    "test:admin": "playwright test --project=admin",
    "test:smoke": "playwright test --grep @smoke",
    "test:app:smoke": "playwright test --project=app --grep @smoke",
    "test:admin:smoke": "playwright test --project=admin --grep @smoke",

    "clean": "rm -rf playwright-report test-results reports",
    "install:browsers": "npx playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "dotenv": "^17.2.3"
  },
  "keywords": [
    "xlm",
    "e2e",
    "playwright",
    "testing",
    "automation"
  ],
  "author": "XLM Team"
}
